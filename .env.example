# Copy to .env  (cp .env.example .env)

# PostgreSQL connection string.
# Option A, local (no install): run `npm run db:start` and keep this value.
# Option B, Neon (free, hosted): paste the "direct" (non-pooled) connection string from the Neon dashboard.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/chronoswap"

# Public base URL, used to build e-mail verification links (FR-1.1).
APP_URL="http://localhost:3000"

# E-mail. Leave SMTP_URL empty in development: e-mails are printed to the terminal instead.
# Example: smtp://user:pass@smtp.example.com:587
SMTP_URL=""
MAIL_FROM="ChronoSwap <no-reply@chronoswap.test>"

# Google Gemini (FR-4.3, FR-8.1). Used from the AI phase onwards; get a key at https://aistudio.google.com
GEMINI_API_KEY=""
# Optional, comma-separated, tried in order when one is overloaded. Empty = built-in list.
GEMINI_MODEL=""

# Optional: credentials of the admin account created by `npm run db:seed`.
SEED_ADMIN_EMAIL="admin@chronoswap.test"
SEED_ADMIN_PASSWORD="Admin#ChronoSwap2026"

# Scheduled jobs (NFR-3): auto-reject, no-show, session timer, 48h release, barter cycles.
# The app server runs them in-process every JOBS_INTERVAL_SECONDS (0 = off).
JOBS_INTERVAL_SECONDS="60"
# Optional: lets an external cron call POST /api/jobs/run with "Authorization: Bearer <secret>".
CRON_SECRET=""
